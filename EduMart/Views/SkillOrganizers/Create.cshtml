@model SkillOrganizers

@{
    ViewData["Title"] = "Add new Agency";
}

<header class="page-head">
    <div class="page-head__text">
        <h1>Add a New Agency</h1>
    </div>
</header>

<div class="sheet sheet--narrow">
    <form asp-action="Create" method="post" class="form">
        <div asp-validation-summary="ModelOnly" class="form__summary"></div>

        <div class="profile">
            <img id="ProfilePicturePreview" class="profile__image" alt="" width="160" height="160" />
            <div class="profile__fields">
                <div class="field">
                    <label asp-for="ProfilePictureURL"></label>
                    <input asp-for="ProfilePictureURL" />
                    <span asp-validation-for="ProfilePictureURL" class="field__error"></span>
                </div>
                <div class="field">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" />
                    <span asp-validation-for="FullName" class="field__error"></span>
                </div>
                <div class="field">
                    <label asp-for="About"></label>
                    <input asp-for="About" />
                    <span asp-validation-for="About" class="field__error"></span>
                </div>
            </div>
        </div>

        <div class="form__actions">
            <input type="submit" value="Create" class="btn btn--primary" />
            <a class="btn btn--quiet" asp-action="Index">Show All</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>

        $(document).ready(function () {
            var output = document.getElementById('ProfilePicturePreview');
            output.src = $("#ProfilePictureURL").val();
        })

        $("#ProfilePictureURL").on("change", function () {
            var output = document.getElementById('ProfilePicturePreview');
            output.src = $(this).val();
        })
    </script>
}

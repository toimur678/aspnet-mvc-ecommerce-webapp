@inject UserManager<ApplicationUser> UserManager;
@inject SignInManager<ApplicationUser> SignInManager;

@{
    var user = await UserManager.GetUserAsync(User);
    var fullName = user?.FullName ?? "User";
}

@if (!User.Identity.IsAuthenticated)
{
    <div class="identity">
        <a class="bar__link" asp-controller="Account" asp-action="Login">Log in</a>
        <a class="btn btn--small" asp-controller="Account" asp-action="Register">Register</a>
    </div>
}
else
{
    <div class="identity">
        @*User profile section*@
        <details class="menu menu--end" data-menu>
            <summary class="bar__link" id="profile-btn">
                Hello @fullName
            </summary>
            <div class="menu__list" aria-labelledby="profile-btn">
                <a class="menu__item" asp-controller="Orders" asp-action="Index">Orders</a>

                @if (User.IsInRole("Admin"))
                {
                    <a class="menu__item" asp-controller="Account" asp-action="Users">Users</a>
                }
            </div>
        </details>
        <form asp-controller="Account" asp-action="Logout">
            <button class="btn btn--small" type="submit">Log out</button>
        </form>
    </div>
}

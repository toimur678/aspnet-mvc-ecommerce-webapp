@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "List of all users";
}

<header class="page-head">
    <div class="page-head__text">
        <h1>List of all users</h1>
        <p class="lead"><span class="num">@Model.Count()</span> accounts.</p>
    </div>
</header>

<div class="sheet">
    <table class="table table--rows table--stack">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.FullName)</th>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td data-label="@Html.DisplayNameFor(model => model.FullName)" class="table__name">
                        @Html.DisplayFor(modelItem => item.FullName)
                    </td>
                    <td data-label="@Html.DisplayNameFor(model => model.Email)">
                        @Html.DisplayFor(modelItem => item.Email)
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>

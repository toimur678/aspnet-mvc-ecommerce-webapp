@using EduMart.Data.ViewModels;
@model RegisterVM;

@{
    ViewData["Title"] = "Sign up for a new account";
}

<div class="split">
    <header class="page-head__text">
        <h1>Sign up for a new account</h1>
    </header>

    <div class="sheet">
        @if (TempData["Error"] != null)
        {
            <div class="alert" role="alert">
                <span><b>Sorry!</b> @TempData["Error"]</span>
            </div>
        }

        <form asp-action="Register" class="form">
            <div asp-validation-summary="ModelOnly" class="form__summary"></div>

                <div class="field">
                    <label asp-for="FullName"></label>
                    <input asp-for="FullName" />
                    <span asp-validation-for="FullName" class="field__error"></span>
                </div>
                <div class="field">
                    <label asp-for="EmailAddress"></label>
                    <input asp-for="EmailAddress" />
                    <span asp-validation-for="EmailAddress" class="field__error"></span>
                </div>
                <div class="field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" />
                    <span asp-validation-for="Password" class="field__error"></span>
                </div>
                <div class="field">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" />
                    <span asp-validation-for="ConfirmPassword" class="field__error"></span>
                </div>

            <div class="form__actions">
                <input class="btn btn--primary" type="submit" value="Sign up" />
                <a class="btn btn--quiet" asp-controller="Skills" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@model Skills

@{
    ViewData["Title"] = "Skills details";
    var expired = DateTime.Now > Model.EndDate;
}

<a class="back" asp-action="Index">Back to List</a>

<article class="detail">
    <div class="detail__media">
        <img src="@Model.ImageURL" alt="@Model.SkillName" width="720" height="720">
    </div>
    <div class="detail__body">
        <header class="page-head__text">
            <h1>@Model.SkillName</h1>
            <p class="lead">@Model.SkillDescription</p>
        </header>

        <dl class="facts facts--grid facts--three">
            <div>
                <dt>Platform</dt>
                <dd>
                    <a asp-controller="Platforms" asp-action="Details" asp-route-id="@Model.PlatformId">
                        @Model.Platforms.PlatformName
                    </a>
                </dd>
            </div>
            <div>
                <dt>Agency</dt>
                <dd>
                    <a asp-controller="SkillOrganizers" asp-action="Details" asp-route-id="@Model.SkillOrganizerID">
                        @Model.Skill_Organizers.FullName
                    </a>
                </dd>
            </div>
            <div><dt>Category</dt><dd>@Model.SkillCategory</dd></div>
            <div><dt>Start date</dt><dd class="num">@Model.StartDate.ToString("dd MMM yy")</dd></div>
            <div><dt>End date</dt><dd class="num">@Model.EndDate.ToString("dd MMM yy")</dd></div>
            <div>
                <dt>Status</dt>
                <dd>
                    @if (DateTime.Now >= Model.StartDate && DateTime.Now <= Model.EndDate)
                    {
                        <span class="status">Available</span>
                    }
                    else if (DateTime.Now > Model.EndDate)
                    {
                        <span class="status status--expired">Expired</span>
                    }
                    else
                    {
                        <span class="status status--upcoming">Upcoming</span>
                    }
                </dd>
            </div>
        </dl>

        <div class="detail__buy">
            <span class="price price--large">@Model.Price.ToString("c")</span>
            <a class="btn btn--primary @((DateTime.Now > Model.EndDate) ? "disabled" : "")"
               asp-controller="Orders"
               asp-action="AddItemToShoppingCart" asp-route-id="@Model.Id"
               aria-disabled="@(expired ? "true" : null)"
               tabindex="@(expired ? "-1" : null)">Add to Cart</a>
        </div>

        <section aria-labelledby="mentors-head">
            <h2 id="mentors-head">Mentors</h2>
            <ul class="people">
                @foreach (var mentor in Model.Mentors_Skills)
                {
                    <li>
                        <img class="avatar" src="@mentor.Mentors.ProfilePictureURL" alt="" width="48" height="48" />
                        <a asp-controller="Mentors" asp-action="Details" asp-route-id="@mentor.MentorID">@mentor.Mentors.FullName</a>
                    </li>
                }
            </ul>
        </section>
    </div>
</article>

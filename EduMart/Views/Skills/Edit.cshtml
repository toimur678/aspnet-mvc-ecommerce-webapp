@model NewSkillsVM
@using EduMart.Data
@using EduMart.Data.Enums

@{
    ViewData["Title"] = "Update Skill";
}

<header class="page-head">
    <div class="page-head__text">
        <h1>Update Skill</h1>
    </div>
</header>

<div class="sheet">
        <form asp-action="Edit" class="form">
            <div asp-validation-summary="ModelOnly" class="form__summary"></div>

            <div class="form__grid">
                <div class="field">
                    <label asp-for="SkillName"></label>
                    <input asp-for="SkillName" />
                    <span asp-validation-for="SkillName" class="field__error"></span>
                </div>
                <div class="field">
                    <label asp-for="Price"></label>
                    <input asp-for="Price" type="number" />
                    <span asp-validation-for="Price" class="field__error"></span>
                </div>
                <div class="field">
                    <label asp-for="StartDate"></label>
                    <input asp-for="StartDate" type="date" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="StartDate" class="field__error"></span>
                </div>
                <div class="field">
                    <label asp-for="EndDate"></label>
                    <input asp-for="EndDate" type="date" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="EndDate" class="field__error"></span>
                </div>
                <div class="field">
                    <label asp-for="PlatformId"></label>
                    <select asp-for="PlatformId" asp-items="ViewBag.Platforms"></select>
                    <span asp-validation-for="PlatformId" class="field__error"></span>
                </div>
                <div class="field">
                    <label asp-for="SkillCategory"></label>
                    <select asp-for="SkillCategory" asp-items="Html.GetEnumSelectList<Skill_Category>()"></select>
                    <span asp-validation-for="SkillCategory" class="field__error"></span>
                </div>
                <div class="field">
                    <label asp-for="SkillOrganizerID"></label>
                    <select asp-for="SkillOrganizerID" asp-items="ViewBag.SkillOrganizers"></select>
                    <span asp-validation-for="SkillOrganizerID" class="field__error"></span>
                </div>
                <div class="field">
                    <label asp-for="MentorIds"></label>
                    <select asp-for="MentorIds" asp-items="ViewBag.Mentors" multiple></select>
                    <span asp-validation-for="MentorIds" class="field__error"></span>
                </div>
                <div class="field field--wide">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description"></textarea>
                    <span asp-validation-for="Description" class="field__error"></span>
                </div>
                <div class="field">
                    <label asp-for="ImageURL"></label>
                    <input asp-for="ImageURL" />
                    <span asp-validation-for="ImageURL" class="field__error"></span>
                </div>
                <div class="field">
                    <span class="label">Image preview</span>
                    <img class="preview" id="ImageUrlPreview" alt="" />
                </div>
            </div>

            <div class="form__actions">
                <input type="submit" value="Update" class="btn btn--primary" />
                <a class="btn btn--quiet" asp-action="Index">Show all</a>
            </div>
        </form>
</div>

@section Scripts {
    <script>

        $(document).ready(function () {
            var output = document.getElementById("ImageUrlPreview");
            output.src = $("#ImageURL").val();
        });

        $("#ImageURL").on("change", function () {
            var output = document.getElementById("ImageUrlPreview");
            output.src = $(this).val();
        })
    </script>
}

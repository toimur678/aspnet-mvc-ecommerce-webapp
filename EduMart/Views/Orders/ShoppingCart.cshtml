@using EduMart.Data.ViewModels;
@model ShoppingCartVM

@{
    ViewData["Title"] = "Shopping cart summary";
    var cartItems = Model.ShoppingCart.ShoppingCartItems;
}

<header class="page-head">
    <div class="page-head__text">
        <h1>Your shopping cart summary</h1>
    </div>
</header>

@if (!cartItems.Any())
{
    <div class="empty">
        <h2>Your cart is empty</h2>
        <p>Add a course from the list and it will wait here until you pay.</p>
        <a class="btn btn--quiet" asp-controller="Skills" asp-action="Index">Browse skills</a>
    </div>
}
else
{
    <div class="sheet">
        <table class="table table--stack">
            <thead>
                <tr>
                    <th>Skill</th>
                    <th>Selected amount</th>
                    <th class="num">Price</th>
                    <th class="num">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in cartItems)
                {
                    <tr>
                        <td data-label="Skill" class="table__name">@item.Skills.SkillName</td>
                        <td data-label="Selected amount">
                            <span class="qty">
                                <a class="qty__btn" asp-controller="Orders" asp-action="RemoveItemFromShoppingCart"
                                   asp-route-id="@item.Skills.Id" aria-label="Remove one @item.Skills.SkillName">
                                    <span aria-hidden="true">&minus;</span>
                                </a>
                                <span class="num">@item.Amount</span>
                                <a class="qty__btn" asp-controller="Orders" asp-action="AddItemToShoppingCart"
                                   asp-route-id="@item.Skills.Id" aria-label="Add one more @item.Skills.SkillName">
                                    <span aria-hidden="true">+</span>
                                </a>
                            </span>
                        </td>
                        <td data-label="Price" class="num">@item.Skills.Price.ToString("c")</td>
                        <td data-label="Subtotal" class="num">@((item.Amount * item.Skills.Price).ToString("c"))</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="total">
                    <td colspan="3">Total</td>
                    <td class="num">
                        @Model.ShoppingCartTotal.ToString("c")
                    </td>
                </tr>
            </tfoot>
        </table>

        <div class="checkout">
            @*<a class="btn btn-outline-primary" asp-action="CompleteOrder">
                    Complete order
                </a>*@
            <a class="btn btn--quiet" asp-controller="Skills" asp-action="Index">
                Add more items
            </a>
            <div id="paypal-btn"></div>
        </div>
    </div>
}

@section Scripts {

    <script src="https://www.paypalobjects.com/api/checkout.js"></script>

    <script>

        let _total = @Html.Raw(Model.ShoppingCartTotal);

        // The PayPal button only renders when the cart has items (the empty state has no #paypal-btn)
        if (document.getElementById('paypal-btn')) paypal.Button.render({
            //Configure environment
            env: 'sandbox',
            client: {
                sandbox: 'AXStEjWjurzbdCfgg9oR_3JwzSRNgRARkf782_veml_qlqGXxZgBOfwPt6CzMGOmZms-pMAr1UYqUd_S'
            },

            //Customize button
            locale: 'en_US',
            style: {
                size: 'responsive',
                color: 'gold',
                shape: 'pill'
            },
            commit: true,

            //Set up a payment
            payment: function (data, actions) {
                return actions.payment.create({
                    transactions: [{
                        amount: {
                            total: _total,
                            currency: 'USD'
                        }
                    }]
                });
            },

            //Execute the payment
            onAuthorize: function (data, actions) {
                return actions.payment.execute().then(function () {
                    var url = '@Url.Action("CompleteOrder", "Orders", new { })';
                    window.location.href = url;
                });
            }

        }, '#paypal-btn')
    </script>
}

@model List<Order>

@{
    ViewData["Title"] = "All orders";
    var isAdmin = User.Identity.IsAuthenticated && User.IsInRole("Admin");
}

<header class="page-head">
    <div class="page-head__text">
        <h1>List of all your orders</h1>
        <p class="lead"><span class="num">@Model.Count</span> @(Model.Count == 1 ? "order" : "orders").</p>
    </div>
</header>

@if (!Model.Any())
{
    <div class="empty">
        <h2>No orders yet</h2>
        <p>Orders appear here once you check out a cart.</p>
        <a class="btn btn--quiet" asp-controller="Skills" asp-action="Index">Browse skills</a>
    </div>
}
else
{
    <div class="sheet">
        <table class="table table--stack">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Items</th>
                    <th class="num">Total</th>
                    @if (isAdmin)
                    {
                        <th>User</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td data-label="Order ID" class="num num--start">@order.Id</td>
                        <td data-label="Items">
                            <ul class="items">
                                @foreach (var item in order.OrderItems)
                                {
                                    <li>
                                        <span class="num">@item.Amount ×</span>
                                        <span>@item.Skills.SkillName</span>
                                        <span class="num">@item.Price.ToString("c")</span>
                                    </li>
                                }
                            </ul>
                        </td>
                        <td data-label="Total" class="num">
                            @order.OrderItems.Select(m => m.Skills.Price * m.Amount).Sum().ToString("c")
                        </td>
                        @if (isAdmin)
                        {
                            <td data-label="User">@(order.User?.FullName)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


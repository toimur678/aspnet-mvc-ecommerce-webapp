@model IEnumerable<Platforms>

@{
    ViewData["Title"] = "List of Platforms";
    var isAdmin = User.Identity.IsAuthenticated && User.IsInRole("Admin");
}

<header class="page-head">
    <div class="page-head__text">
        <h1>Platforms</h1>
        <p class="lead"><span class="num">@Model.Count()</span> on record.</p>
    </div>
    <div class="page-head__actions">
        @*  Partial View   *@
        @await Html.PartialAsync("_CreateItem", "Platforms")
    </div>
</header>

<div class="sheet">
    <table class="table table--rows table--stack">
        <thead>
            <tr>
                <th><span class="visually-hidden">@Html.DisplayNameFor(model => model.PlatformLogo)</span></th>
                <th>@Html.DisplayNameFor(model => model.PlatformName)</th>
                <th>@Html.DisplayNameFor(model => model.Description)</th>
                @if (isAdmin)
                {
                    <th><span class="visually-hidden">Actions</span></th>
                }
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td data-label="">
                        <img class="table__thumb table__thumb--contain" src="@item.PlatformLogo" alt="@item.PlatformName" width="56" height="56" />
                    </td>
                    <td data-label="@Html.DisplayNameFor(model => model.PlatformName)" class="table__name">
                        <a asp-action="Details" asp-route-id="@item.Id">@Html.DisplayFor(modelItem => item.PlatformName)</a>
                    </td>
                    <td data-label="@Html.DisplayNameFor(model => model.Description)" class="table__desc">
                        @Html.DisplayFor(modelItem => item.Description)
                    </td>
                    @if (isAdmin)
                    {
                        <td data-label="">
                            <div class="table__actions">
                                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                                <a class="link-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

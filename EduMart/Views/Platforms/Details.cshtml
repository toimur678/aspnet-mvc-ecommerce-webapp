@model Platforms

@{
    ViewData["Title"] = "Detail of Platform";
}

<header class="page-head">
    <div class="page-head__text">
        <h1>Details for @Model.PlatformName</h1>
    </div>
</header>

<div class="sheet sheet--narrow">
    <div class="form">
        <div class="profile">
            <img id="PlatformLogoPreview" class="profile__image profile__image--contain" alt="" width="160" height="160" />
            <div class="profile__fields">
                @* The preview script reads the image URL from this input *@
                <input type="hidden" asp-for="PlatformLogo" />
                <dl class="facts">
                    <div><dt>@Html.DisplayNameFor(model => model.PlatformName)</dt><dd>@Model.PlatformName</dd></div>
                    <div><dt>@Html.DisplayNameFor(model => model.Description)</dt><dd>@Model.Description</dd></div>
                    <div><dt>@Html.DisplayNameFor(model => model.PlatformLogo)</dt><dd class="facts__url">@Model.PlatformLogo</dd></div>
                </dl>
            </div>
        </div>

        <div class="form__actions">
            @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
            {
                <a class="btn btn--primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            }
            <a class="btn btn--quiet" asp-action="Index">Show All</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        $(document).ready(function () {
            var output = document.getElementById('PlatformLogoPreview');
            output.src = $("#PlatformLogo").val();
        })

    </script>
}

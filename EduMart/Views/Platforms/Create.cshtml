@model Platforms

@{
    ViewData["Title"] = "Add new Platform";
}

<header class="page-head">
    <div class="page-head__text">
        <h1>Add a New Platform</h1>
    </div>
</header>

<div class="sheet sheet--narrow">
    <form asp-action="Create" method="post" class="form">
        <div asp-validation-summary="ModelOnly" class="form__summary"></div>

        <div class="profile">
            <img id="PlatformLogoPreview" class="profile__image profile__image--contain" alt="" width="160" height="160" />
            <div class="profile__fields">
                <div class="field">
                    <label asp-for="PlatformLogo"></label>
                    <input asp-for="PlatformLogo" />
                    <span asp-validation-for="PlatformLogo" class="field__error"></span>
                </div>
                <div class="field">
                    <label asp-for="PlatformName"></label>
                    <input asp-for="PlatformName" />
                    <span asp-validation-for="PlatformName" class="field__error"></span>
                </div>
                <div class="field">
                    <label asp-for="Description"></label>
                    <input asp-for="Description" />
                    <span asp-validation-for="Description" class="field__error"></span>
                </div>
            </div>
        </div>

        <div class="form__actions">
            <input type="submit" value="Create" class="btn btn--primary" />
            <a class="btn btn--quiet" asp-action="Index">Show All</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>

        $(document).ready(function () {
            var output = document.getElementById('PlatformLogoPreview');
            output.src = $("#PlatformLogo").val();
        })

        $("#PlatformLogo").on("change", function () {
            var output = document.getElementById('PlatformLogoPreview');
            output.src = $(this).val();
        })
    </script>
}

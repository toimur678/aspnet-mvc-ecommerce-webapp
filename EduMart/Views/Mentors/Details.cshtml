@model Mentors

@{
    ViewData["Title"] = "Mentor details";
}

<header class="page-head">
    <div class="page-head__text">
        <h1>Details for @Model.FullName</h1>
    </div>
</header>

<div class="sheet sheet--narrow">
    <div class="form">
        <div class="profile">
            <img id="ProfilePicturePreview" class="profile__image" alt="" width="160" height="160" />
            <div class="profile__fields">
                @* The preview script reads the image URL from this input *@
                <input type="hidden" asp-for="ProfilePictureURL" />
                <dl class="facts">
                    <div><dt>@Html.DisplayNameFor(model => model.FullName)</dt><dd>@Model.FullName</dd></div>
                    <div><dt>@Html.DisplayNameFor(model => model.About)</dt><dd>@Model.About</dd></div>
                    <div><dt>@Html.DisplayNameFor(model => model.ProfilePictureURL)</dt><dd class="facts__url">@Model.ProfilePictureURL</dd></div>
                </dl>
            </div>
        </div>

        <div class="form__actions">
            @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
            {
                <a class="btn btn--primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
            }
            <a class="btn btn--quiet" asp-action="Index">Show All</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        $(document).ready(function () {
            var output = document.getElementById('ProfilePicturePreview');
            output.src = $("#ProfilePictureURL").val();
        })

    </script>
}
